# Vault Bridge Relay — instance config template
# Copy to wrangler.toml (gitignored) and fill in your values before deploying.

name = "vault-bridge-relay"
main = "src/index.ts"

# Do not bump casually: later dates change WebSocket close/binary semantics
# that relay mode depends on.
compatibility_date = "2024-12-01"

# Your Cloudflare account ID (Dashboard → Workers & Pages → right-hand sidebar).
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

workers_dev = true

# Optional: serve on a custom domain whose zone is in your Cloudflare account.
# Delete this block to use the *.workers.dev hostname instead.
# routes = [
#   { pattern = "vault-bridge.example.com/*", zone_name = "example.com" }
# ]

[observability]
enabled = true

[vars]
# IANA timezone used to date-stamp `updated:` frontmatter on MCP writes.
# MCP writes come from Claude, not the plugin, so the vault's local date can
# only be resolved here. Defaults to UTC if omitted. Example: "Australia/Melbourne".
VAULT_TZ = "UTC"

[[durable_objects.bindings]]
name = "VAULT_SESSION"
class_name = "VaultSession"

[[durable_objects.bindings]]
name = "VAULT_INDEX"
class_name = "VaultIndexDO"

[[kv_namespaces]]
binding = "TOKENS"
# Create with: npx wrangler kv namespace create VAULT_BRIDGE_TOKENS
id = "YOUR_KV_NAMESPACE_ID"

[[r2_buckets]]
binding = "VAULT_BUCKET"
# Create with: npx wrangler r2 bucket create vault-bridge
bucket_name = "vault-bridge"

# Applied automatically on first deploy — do not edit.
[[migrations]]
tag = "v1"
new_sqlite_classes = ["VaultSession"]

[[migrations]]
tag = "v2"
new_sqlite_classes = ["VaultIndexDO"]
